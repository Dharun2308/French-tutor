# Copy this file to .env.local and fill in real values.

# --- Turso ---
# Create a database at https://turso.tech, then run:
#   turso db show <your-db> --url
#   turso db tokens create <your-db>
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- OpenAI ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
# Optional overrides. Default is gpt-5-mini.
OPENAI_MODEL="gpt-5-mini"
# Optional override for text-to-speech. Default is gpt-4o-mini-tts.
# Only used when TTS mode is set to "openai" in Settings.
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
# Optional override for reading handwritten notebook photos (Import Lesson Notes).
# Defaults to gpt-5 — extraction runs once per lesson and accuracy matters most there.
OPENAI_VISION_MODEL="gpt-5"

# --- Seed endpoint protection ---
# Any string. Only needed if you hit POST /api/seed in production.
SEED_TOKEN="choose-a-long-random-string"

# --- Structured-AI providers (Import Lesson Notes, item grading) ---
# Order is fixed: codex → claude → openai. Enable/disable each in Settings.
# Codex runs under your ChatGPT login (codex login). Claude runs under your
# Claude login (claude auth). Neither needs an API key; both have theirs
# stripped from the child env so they can never bill the API by accident.
# CODEX_MODEL="gpt-5.6-terra"          # or gpt-5.6-luna / gpt-5.5 / gpt-5.4-mini
# CODEX_REASONING_EFFORT="low"
# CLAUDE_MODEL="sonnet"
# CLAUDE_EFFORT="medium"
# CODEX_BIN=/home/you/.local/bin/codex
# CLAUDE_BIN=/home/you/.local/bin/claude
